# Local development fleet from docker-compose.fleet.yml.
# Copy to .iristool.toml in the workspace used by your MCP client.
default_server = "writable"

[instance.writable]
host = "localhost"
port = 9191  # SQL port; Management Portal uses 9192
namespace = "USER"
username = "_SYSTEM"
password = "SYS"  # Default login for the disposable development image
read_only = false

[instance.readonly]
host = "localhost"
port = 9291  # SQL port; Management Portal uses 9292
namespace = "USER"
username = "_SYSTEM"
password = "SYS"
read_only = true

# read_only blocks MCP writes; _SYSTEM still has database write privileges.
# Use a restricted SQL account for database-enforced read-only access.
# The integration tests create restricted accounts temporarily and remove them.

# Optional dataset credentials for this workspace. Uncomment to enable.
# Keep real tokens out of version control. Choose token OR token_env per provider.
# [providers.huggingface]
# token = "hf_your_token"
# # Alternative: token_env = "THIS_WORKSPACE_HF_TOKEN"

# [providers.kaggle]
# token = "your_kaggle_api_token"
# # Alternative: token_env = "THIS_WORKSPACE_KAGGLE_TOKEN"
