default_server = "dev"

[instance.dev]
host = "localhost"
port = 9091  # SQL SuperServer port, not the Management Portal port
namespace = "USER"
username = "_SYSTEM"
password_env = "IRIS_DEV_PASSWORD"

# Each instance is independent; credentials are never inherited.
# [instance.reporting]
# host = "reporting.example.com"
# port = 1972
# namespace = "REPORTING"
# username = "reader"
# password_env = "IRIS_REPORTING_PASSWORD"
# read_only = true

# Optional dataset credentials for this workspace. Uncomment to enable.
# Keep real tokens out of version control. Choose token OR token_env per provider.
# [providers.huggingface]
# token = "hf_your_token"
# # Alternative: token_env = "THIS_WORKSPACE_HF_TOKEN"

# [providers.kaggle]
# token = "your_kaggle_api_token"
# # Alternative: token_env = "THIS_WORKSPACE_KAGGLE_TOKEN"
