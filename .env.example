# Local Docker development server (docker compose up -d --build).
# Copy this file to .env; see README.md for loading instructions.
IRIS_HOST=localhost
IRIS_PORT=9091
IRIS_NAMESPACE=USER
IRIS_USER=_SYSTEM
IRIS_PASSWORD=SYS

# Optional: private or consent-required Kaggle datasets.
# KAGGLE_API_TOKEN='your-kaggle-token'

# Optional: private or gated Hugging Face datasets.
# HF_TOKEN='your-hugging-face-read-token'
